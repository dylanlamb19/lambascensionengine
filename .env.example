# Google OAuth (Gmail send/readonly + Calendar events/freebusy). Never put secrets in frontend code.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
APP_SECRET=

# Optional cron auth for POST /api/jobs/outreach
# Preview: Vite ticks the worker every 60s in-process.
# Production (Vercel): vercel.json runs /api/jobs/outreach every 5 minutes.
# Set CRON_SECRET to the same value as OUTREACH_JOB_SECRET so Vercel Cron is accepted.
OUTREACH_JOB_SECRET=
CRON_SECRET=

# Live-preview OAuth client secret (server-only). Leave this empty in git.
# Set it on the deploy host (Vercel) before preview sign-in can work.
# GROK_AUTH_CLIENT_SECRET, when set, takes precedence (per-app deployed client).
# If both are unset, preview sign-in is disabled. Never commit a real value.
GROK_PREVIEW_CLIENT_SECRET=

