# Google OAuth (Gmail send/readonly + Calendar events/freebusy). Never put secrets in frontend code.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
APP_SECRET=

# Optional cron auth for POST /api/jobs/outreach
# Preview: Vite ticks the worker every 60s in-process.
# Production (Vercel): vercel.json runs /api/jobs/outreach every 5 minutes.
# Set CRON_SECRET to the same value as OUTREACH_JOB_SECRET so Vercel Cron is accepted.
OUTREACH_JOB_SECRET=
CRON_SECRET=

