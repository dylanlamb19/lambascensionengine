# Copy to .env — never commit real secrets.

APP_ENV=development
APP_SECRET=change-me-to-a-long-random-string
APP_HOST=127.0.0.1
APP_PORT=8080

# Single-user auth for Phase 1
ADMIN_EMAIL=you@lambascension.com
ADMIN_PASSWORD=change-me

DATABASE_URL=sqlite:///./data/lead_engine.db

# Daily caps (Phase 2+)
DAILY_DISCOVERY_LIMIT=50
DAILY_ENRICHMENT_LIMIT=20
DAILY_AUDIT_LIMIT=40
DAILY_SPEND_CAP_CENTS=500
QUALIFY_THRESHOLD=50
CACHE_DAYS=7

# Phase 2 — Google Places (New)
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_REGION=us

# Optional website performance
PAGESPEED_API_KEY=

# Phase 4 — contact enrichment (Stage D only, after qualification)
HUNTER_API_KEY=
ENABLE_CONTACT_ENRICHMENT=false
ENRICHMENT_MIN_SCORE=65
DAILY_ENRICHMENT_LIMIT=10
MONTHLY_ENRICHMENT_BUDGET_CENTS=1500
WEBSITE_AUDIT_CACHE_DAYS=14
DEEP_RESEARCH_CACHE_DAYS=14

# Phase 5 OAuth (leave empty until enabled)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
HUBSPOT_ACCESS_TOKEN=

# Feature flags
ENABLE_PLACES_DISCOVERY=false
ENABLE_CONTACT_ENRICHMENT=false
ENABLE_AI_ANALYSIS=false
FRONTEND_ORIGIN=
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
